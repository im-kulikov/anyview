# Скопируйте в .env.local.
VITE_BASE=/anyview/
VITE_ANIMEVOST_BASES=https://api.animetop.info/v1,https://api.animevost.org/v1
# Абсолютный адрес сайта для og:image (по умолчанию https://im-kulikov.github.io + VITE_BASE).
# VITE_SITE_URL=https://example.org/anyview/
# VITE_PROVIDER=animevost   # или anyview (заготовка, фаза 2); VITE_API_BASE — база своего API
